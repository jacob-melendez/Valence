# Copy to .env. Keeps every library offline after the one-time model downloads.
YOLO_OFFLINE=1
YOLO_AUTOINSTALL=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# macOS live mode: torch is imported before LightGBM (valence/api/app.py) and LightGBM predicts with
# num_threads=1. Do NOT set OMP_NUM_THREADS (measured: segfault). Requires `brew install libomp`.
# Fallback only if a libomp clash still appears:
# KMP_DUPLICATE_LIB_OK=TRUE

# Valence runtime (see valence/config.py for all VALENCE_* settings)
VALENCE_MODE=replay
VALENCE_STATE_SET=core
VALENCE_BREAK_ABSENT_MIN=10
VALENCE_DB_CAL_OFFSET=94
