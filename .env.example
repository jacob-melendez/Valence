# Copy to .env. Keeps every library offline after the one-time model downloads.
YOLO_OFFLINE=1
YOLO_AUTOINSTALL=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# macOS live mode: torch is imported before LightGBM (valence/api/app.py), valence.edge.run sets
# OMP_NUM_THREADS=1 before importing torch (LightGBM's model parsing otherwise segfaults), and LightGBM predicts
# with num_threads=1. Do not override OMP_NUM_THREADS in live mode. Requires `brew install libomp`.
# Fallback only if a libomp clash still appears:
# KMP_DUPLICATE_LIB_OK=TRUE

# Valence runtime (see valence/config.py for all VALENCE_* settings)
VALENCE_MODE=replay
VALENCE_STATE_SET=core
VALENCE_BREAK_ABSENT_MIN=10
VALENCE_DB_CAL_OFFSET=94
